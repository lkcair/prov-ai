    prov:value "[{\"role\": \"assistant\", \"parts\": [{\"type\": \"thinking\", \"content\": \"We need to call weather_agent and facts_agent in parallel for Lisbon. Then hand off to writer with final_result. So first call both.\"}, {\"type\": \"tool_call\", \"id\": \"call-9fe644d5-e278-4bba-b6f8-7f01cba0db31\", \"name\": \"weather_agent\", \"arguments\": \"{\\\"city\\\": \\\"Lisbon\\\"}\"}, {\"type\": \"tool_call\", \"id\": \"call-78f8740a-c4d8-4b30-a1cf-6d64fea36fb6\", \"name\": \"facts_agent\", \"arguments\": \"{\\\"city\\\": \\\"Lisbon\\\"}\"}], \"finish_reason\": \"tool_call\"}]" ;
