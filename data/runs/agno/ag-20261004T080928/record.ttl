    prov:value "{\"messages\": [{\"id\": \"ba3d04a2-ca3d-4b21-826b-5c0303d78ad4\", \"content\": \"You write two-sentence briefs about a city. Always call read_note for the city first. Reply with the brief only.\", \"from_history\": false, \"stop_after_tool_call\": false, \"role\": \"system\", \"created_at\": 1791101376}, {\"id\": \"14ee5658-0337-473b-bd64-506e23ea4b14\", \"content\": \"Write a two-sentence brief on Lisbon based on the following findings: The weather in Lisbon is currently 21°C with a clear sky. The tone should be informative and concise.\", \"from_history\": false, \"stop_after_tool_call\": false, \"role\": \"user\", \"created_at\": 1791101376}]}" ;
